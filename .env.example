# ==============================================================================
# Токены доступа к LLM API для хакатона «Идея фикс» (Сферум • ООО «МАХ»)
# ==============================================================================

# 1. Sber GigaChat API (ClientID:ClientSecret в Base64 или авторизационный токен)
# Регистрация на https://developers.sber.ru/portal/products/gigachat-api
GIGACHAT_CREDENTIALS=your_gigachat_credentials_here

# 2. DeepSeek API Key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 3. YandexGPT API (Yandex Cloud)
# https://yandex.cloud/ru/docs/foundation-models/quickstart/yandexgpt
YANDEX_API_KEY=your_yandex_api_key_here
YANDEX_FOLDER_ID=your_yandex_folder_id_here
